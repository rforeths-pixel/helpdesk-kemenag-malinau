/* =========================
   NAVBAR
========================= */

nav {
    background: #0b6b3a;
    color: white;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 10px 8%;
}

/* Bagian logo dan tulisan */

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Logo Kemenag */

.logo-kemenag {
    width: 60px;
    height: 60px;

    object-fit: contain;

    background: white;
    padding: 3px;

    border-radius: 50%;
}

/* Tulisan */

.brand-text h3 {
    margin: 0;
    font-size: 20px;
}

.brand-text span {
    font-size: 13px;
}

/* Menu */

.menu {
    display: flex;
    align-items: center;
    gap: 20px;
}

.menu a {
    color: white;
    text-decoration: none;

    font-weight: 500;
}

.menu a:hover {
    text-decoration: underline;
}